<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
	
	<bean id="hibernateAnnotatedClasses"
		class="org.springframework.beans.factory.config.ListFactoryBean">
		<property name="sourceList">
			<list>
				<value>org.wyttenbach.dale.document.model.Document</value>
			</list>
		</property>
	</bean>
	
	<!-- children must supply a "dataSource" bean and resolve the ${...} placeholders -->
	<bean id="abstractSessionFactory" class="org.springframework.orm.hibernate5.LocalSessionFactoryBean" abstract="true">
		<property name="dataSource" ref="dataSource" />
		<property name="annotatedClasses">
			<ref bean="hibernateAnnotatedClasses" />
		</property>
		<property name="hibernateProperties">
			<props>
				<prop key="hibernate.hbm2ddl.auto">${hibernate.hbm2ddl.auto}</prop>
				<prop key="hibernate.show_sql">${hibernate.show_sql}</prop>
				<prop key="hibernate.format_sql">${hibernate.format_sql}</prop>
				<prop key="hibernate.use_sql_comments">${hibernate.use_sql_comments}</prop>
			</props>
		</property>
	</bean>
	
</beans>
