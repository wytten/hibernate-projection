<?xml version="1.0" encoding="UTF-8" ?>
<configuration>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{dd MMM yyyy HH:mm:ss} [%-5level] [%logger{2}.%method] - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="org.wyttenbach" level="debug" />

  <root level="warn">
    <appender-ref ref="STDOUT" />
  </root>

</configuration>
